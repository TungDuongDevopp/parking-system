@using ParkingSystem.Web.Models.Staff
@model EditStaffViewModel
@{
    Layout = null;
}
<form name="StaffEditForm" role="form" class="form-horizontal">
    <input type="hidden" name="Id" value="@Model.Staff.Id" />
    <div class="modal-header">
        <h5 class="modal-title">@L("EditStaff"): @Model.Staff.Name</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div class="form-group row required mb-3">
            <label class="col-md-3 col-form-label">@L("Name")</label>
            <div class="col-md-9">
                <input type="text" class="form-control" name="Name" value="@Model.Staff.Name" required maxlength="100">
            </div>
        </div>

        <div class="form-group row required mb-3">
            <label class="col-md-3 col-form-label">@L("PhoneNumber")</label>
            <div class="col-md-9">
                <input type="text" class="form-control" name="PhoneNumber" value="@Model.Staff.PhoneNumber" required maxlength="20">
            </div>
        </div>

        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">@L("EmailAddress")</label>
            <div class="col-md-9">
                <input type="email" class="form-control" name="Email" value="@Model.Staff.Email" maxlength="255">
            </div>
        </div>

        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">@L("Gender")</label>
            <div class="col-md-9">
                <select class="form-control" name="Gender">
                    <option value="" selected="@(!Model.Staff.Gender.HasValue)">@L("Unspecified")</option>
                    <option value="true" selected="@(Model.Staff.Gender.HasValue && Model.Staff.Gender.Value)">@L("Male")</option>
                    <option value="false" selected="@(Model.Staff.Gender.HasValue && !Model.Staff.Gender.Value)">@L("Female")</option>
                </select>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">@L("DateOfBirth")</label>
            <div class="col-md-9">
                <input type="date" class="form-control" name="DateOfBirth"
                       value="@(Model.Staff.DateOfBirth?.ToString("yyyy-MM-dd"))"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")">
            </div>
        </div>

        <div class="form-group row required mb-3">
            <label class="col-md-3 col-form-label">@L("HiredDate")</label>
            <div class="col-md-9">
                <input type="date" class="form-control" name="HiredDate"
                       value="@(Model.Staff.HiredDate.ToString("yyyy-MM-dd"))"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" required>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">@L("Address")</label>
            <div class="col-md-9">
                <textarea class="form-control" name="Address" rows="2" maxlength="1023">@Model.Staff.Address</textarea>
            </div>
        </div>
    </div>
    <div class="modal-footer justify-content-between">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L("Cancel")</button>
        <button type="submit" class="btn btn-primary save-button">@L("Save")</button>
    </div>
</form>
<script src="~/view-resources/Views/Staff/_EditModal.js" asp-append-version="true"></script>
